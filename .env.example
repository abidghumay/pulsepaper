# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration (PostgreSQL)
# For local dev without Postgres installed, leaving this empty will auto-fallback to embedded PGlite (WASM Postgres)
# In production (e.g. Neon Free Tier), set your PostgreSQL connection string:
# DATABASE_URL=postgresql://username:password@ep-cool-db.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Automated Ingestion Schedule (Default: 5:00 AM Asia/Dhaka)
CRON_SCHEDULE=0 5 * * *
CRON_TIMEZONE=Asia/Dhaka

# Optional AI Summarization (Free Google Gemini API Key)
# Get a free key at: https://aistudio.google.com/
# If omitted, system seamlessly falls back to offline extractive NLP summarization
GEMINI_API_KEY=
